{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectNamedStorageStacks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackResources",
        "cloudformation:DescribeStackResource",
        "cloudformation:ListStackResources",
        "cloudformation:DescribeChangeSet",
        "cloudformation:GetTemplate",
        "cloudformation:GetStackPolicy",
        "cloudformation:DescribeStackResourceDrifts",
        "cloudformation:DetectStackDrift",
        "cloudformation:DetectStackResourceDrift"
      ],
      "Resource": [
        "arn:aws:cloudformation:eu-west-1:497087877832:stack/guito-sessions-staging/*",
        "arn:aws:cloudformation:eu-west-1:497087877832:stack/guito-sessions-production/*",
        "arn:aws:cloudformation:eu-west-1:497087877832:stack/guito-postgres-shared/*"
      ]
    },
    {
      "Sid": "InspectNamedStoragePredeploymentEvents",
      "Effect": "Allow",
      "Action": "cloudformation:DescribeEvents",
      "Resource": [
        "arn:aws:cloudformation:eu-west-1:497087877832:stack/guito-sessions-staging/*",
        "arn:aws:cloudformation:eu-west-1:497087877832:stack/guito-sessions-production/*",
        "arn:aws:cloudformation:eu-west-1:497087877832:stack/guito-postgres-shared/*",
        "arn:aws:cloudformation:eu-west-1:497087877832:changeSet/guito-infra-*/*"
      ]
    },
    {
      "Sid": "TagOnlyNamedStorageStackMetadata",
      "Effect": "Allow",
      "Action": "cloudformation:TagResource",
      "Resource": [
        "arn:aws:cloudformation:eu-west-1:497087877832:stack/guito-sessions-staging/*",
        "arn:aws:cloudformation:eu-west-1:497087877832:stack/guito-sessions-production/*"
      ]
    },
    {
      "Sid": "PlanOnlyNativeSessionTableChanges",
      "Effect": "Allow",
      "Action": "cloudformation:CreateChangeSet",
      "Resource": [
        "arn:aws:cloudformation:eu-west-1:497087877832:stack/guito-sessions-staging/*",
        "arn:aws:cloudformation:eu-west-1:497087877832:stack/guito-sessions-production/*"
      ],
      "Condition": {
        "StringLike": {
          "cloudformation:ChangeSetName": "guito-infra-*"
        },
        "ForAllValues:StringEquals": {
          "cloudformation:ResourceTypes": [
            "AWS::DynamoDB::Table"
          ]
        },
        "Null": {
          "cloudformation:ResourceTypes": "false",
          "cloudformation:RoleArn": "true"
        }
      }
    },
    {
      "Sid": "ExecuteOnlyNamedStoragePlans",
      "Effect": "Allow",
      "Action": "cloudformation:ExecuteChangeSet",
      "Resource": [
        "arn:aws:cloudformation:eu-west-1:497087877832:stack/guito-sessions-staging/*",
        "arn:aws:cloudformation:eu-west-1:497087877832:stack/guito-sessions-production/*"
      ],
      "Condition": {
        "StringLike": {
          "cloudformation:ChangeSetName": [
            "guito-infra-*",
            "arn:aws:cloudformation:eu-west-1:497087877832:changeSet/guito-infra-*/*"
          ]
        }
      }
    },
    {
      "Sid": "ValidateNativeTemplatesAndInspectDriftOperations",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ValidateTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:DescribeStackDriftDetectionStatus",
        "cloudformation:BatchDescribeTypeConfigurations"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    },
    {
      "Sid": "InspectAndTagOnlyNamedSessionTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:ListTagsOfResource",
        "dynamodb:DescribeContributorInsights",
        "dynamodb:DescribeKinesisStreamingDestination",
        "dynamodb:GetResourcePolicy",
        "dynamodb:TagResource",
        "dynamodb:UntagResource"
      ],
      "Resource": [
        "arn:aws:dynamodb:eu-west-1:497087877832:table/guito-api-user-sessions-staging",
        "arn:aws:dynamodb:eu-west-1:497087877832:table/guito-api-user-sessions"
      ]
    }
  ]
}
