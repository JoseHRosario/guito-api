{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AppConfiguration": {
    "Googlesheets": {
      "ExpensesRange": "Expenses!B5",
      "ExpensesDateRange": "Expenses!C",
      "ExpensesLatestRange": "Expenses!B{0}:H{1}",
      "CredentialLocation": "Filesystem",
      "FilePath": "google-spreadsheets.json"
    },
    "Authentication": {
      "ValidateIdToken": true
    }
  }
}